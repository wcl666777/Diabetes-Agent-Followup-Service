# 复制为 .env 并填写实际值（.env 不提交）

# ── 服务监听 ──
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# ── DeepSeek 大模型（OpenAI 兼容接口）──
DEEPSEEK_API_KEY=sk-your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# ── MySQL（患者档案 / 血糖记录 / 会话历史 / 人工介入）──
DB_HOST=localhost
DB_PORT=3307
DB_NAME=diabetes
DB_USER=diabetes
DB_PASSWORD=diabetes123

# ── JWT 认证（生产环境务必更换 JWT_SECRET 为长随机串）──
JWT_SECRET=please_change_me_to_a_long_random_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── RAG 服务的 MCP Server 地址（问答 Agent 通过 MCP 调用知识检索）──
# RAG 的 REST 与 MCP 同进程部署在 8001，MCP 端点为 /rag/mcp
RAG_MCP_SERVER_URL=http://localhost:8001/rag
# 调用 RAG 服务所需密钥，须与 rag_service/.env 的 RAG_API_KEY 保持一致
RAG_API_KEY=please_change_me_to_a_long_random_secret

# ── 问答 Agent 转人工阈值（精排置信度低于此值转人工）──
QA_CONFIDENCE_THRESHOLD=0.5
